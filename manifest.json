{
  "manifest_version": 3,
  "name": "Media Downloader — Native Test",
  "short_name": "Media Downloader",
  "version": "0.2.3",
  "key": "",
  "minimum_chrome_version": "120",
  "description": "Тестовая Native-версия: показывает реальные качества и сохраняет выбранное видео через локальный движок.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "src/native-background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/core/filename.js",
        "src/core/native.js",
        "src/native-content.js",
        "src/native-hardware-status.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Media Downloader — Native Test"
  }
}
